{
  "name": "hng-shop-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@hng-shop/web",
    "build": "npm run build --workspace=@hng-shop/web",
    "start": "npm run start --workspace=@hng-shop/web",
    "lint": "npm run lint --workspace=@hng-shop/web",
    "seed:demo": "npm run seed:demo --workspace=@hng-shop/web",
    "replay:paid-event": "npm run replay:paid-event --workspace=@hng-shop/web --",
    "db:studio": "npm run db:studio --workspace=@hng-shop/web",
    "db:generate": "npm run db:generate --workspace=@hng-shop/web"
  }
}
