# Public backend API URL (URL of the Next.js web application)
# For local Android emulator use: http://10.0.2.2:3000
# For local iOS simulator or web use: http://localhost:3000
# For physical devices use your computer LAN IP or deployed URL: https://your-site.netlify.app
EXPO_PUBLIC_API_URL=http://localhost:3000

# Supabase Auth Configuration (Matches apps/web)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
